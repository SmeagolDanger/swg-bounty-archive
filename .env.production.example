APP_IMAGE=ghcr.io/smeagoldanger/swg-bounty-archive:latest
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3017

POSTGRES_USER=swg
POSTGRES_PASSWORD=replace_with_a_long_url_safe_random_password
POSTGRES_DB=swg_bounty
DATABASE_URL=postgresql://swg:replace_with_a_long_url_safe_random_password@postgres:5432/swg_bounty

ADMIN_USERNAME=admin
# Keep the single quotes: Docker Compose otherwise expands bcrypt's $ characters.
ADMIN_PASSWORD_HASH=''
PUBLIC_API_RATE_LIMIT_PER_MINUTE=120
INGESTION_CONCURRENCY=2
INGESTION_TIMEOUT_MS=10000
INGESTION_MAX_RETRIES=3
LOG_LEVEL=info

# Optional. The source values are consumed by the host log shipper; only the heartbeat URL reaches the worker.
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGESTING_HOST=
BETTERSTACK_HEARTBEAT_URL=
BETTERSTACK_HEARTBEAT_TIMEOUT_MS=3000
HEALTH_WORKER_STALE_SECONDS=900

BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=0
