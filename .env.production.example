APP_IMAGE=ghcr.io/smeagoldanger/swg-bounty-archive:latest
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3017
# Optional public origin, e.g. https://ledger.example.com. Enables canonical URLs and absolute metadata.
PUBLIC_SITE_URL=

POSTGRES_USER=swg
POSTGRES_PASSWORD=replace_with_a_long_url_safe_random_password
POSTGRES_DB=swg_bounty
DATABASE_URL=postgresql://swg:replace_with_a_long_url_safe_random_password@postgres:5432/swg_bounty

ADMIN_USERNAME=admin
# Keep the single quotes: Docker Compose otherwise expands bcrypt's $ characters.
ADMIN_PASSWORD_HASH=''
PUBLIC_API_RATE_LIMIT_PER_MINUTE=120
# Poll cadence, start to start. Keep it a little over 300: SWG Legends caches the
# bounty feed for 300 s on demand, and an exact 300 s cadence gets a stale
# snapshot on every other poll. Minimum 60.
INGESTION_INTERVAL_SECONDS=310
INGESTION_CONCURRENCY=2
INGESTION_TIMEOUT_MS=10000
INGESTION_MAX_RETRIES=3
LOG_LEVEL=info

# Optional hosted observability. Create a server-side ingest token scoped only to this dataset.
AXIOM_TOKEN=
# Recommended when enabled: outer-rim-ledger-production
AXIOM_DATASET=
AXIOM_ENVIRONMENT=production
HEALTH_WORKER_STALE_SECONDS=900

BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=0

# Nightly off-box backups → Cloudflare R2 (docs/backups.md). The `backup`
# service dumps the database daily at BACKUP_AT (UTC), verifies it, uploads it
# to R2_BACKUP_BUCKET/backups/daily (monthly/ on the 1st), keeps 7 local and
# 30 remote daily copies, and restore-tests the newest dump every Sunday.
# Create the R2 API token in the dashboard (R2 → Manage API tokens, Object
# Read & Write, scoped to the bucket). Blank credentials disable uploads and
# the service reports a failure each night until they are set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=swg-bounty-backups
BACKUP_AT=03:15
BACKUP_LOCAL_RETENTION_DAYS=7
BACKUP_R2_DAILY_RETENTION_DAYS=30
BACKUP_RESTORE_DRILL_DAY=Sun
# Optional dead-man's switch (healthchecks.io ping URL): alerts when a backup does NOT happen.
BACKUP_HEALTHCHECK_URL=
# Optional Discord webhook for backup/drill failure messages.
BACKUP_DISCORD_WEBHOOK_URL=

# Weekly report → Discord (blank disables). The worker posts the finished
# cycle's report image ~30 minutes after each Saturday 22:00 UTC reset.
DISCORD_REPORT_WEBHOOK_URL=

# Live encounter feed → Discord (blank disables). One or more channel webhook
# URLs, comma-separated, one per server/channel. After each poll the worker
# posts every newly archived bounty encounter as an embed, oldest first, to
# each webhook and retries undelivered ones next cycle. A webhook never
# receives encounters archived before it was added. See docs/discord-encounter-feed.md.
DISCORD_BOUNTY_WEBHOOK_URL=

# Cloudflare standby capture (docs/capture-standby.md). The worker sends a
# heartbeat here after each poll that archived the bounty feed; if heartbeats
# stop, the Worker captures the feed itself so an outage leaves no gap. Blank
# disables. TOKEN must match the Worker's CAPTURE_TOKEN secret.
CAPTURE_STANDBY_URL=
CAPTURE_STANDBY_TOKEN=

# Jawa Tracks accounts: create a Discord application (see docs/accounts.md)
# and paste its OAuth credentials. Blank disables sign-in; the public
# archive is unaffected.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
AUTH_BASE_URL=https://jawatracks.com

# Slash-command bot (/feed, /hunter) — see docs/discord-bot.md. The same Discord
# application as sign-in. PUBLIC_KEY enables the interactions endpoint; BOT_TOKEN
# is only needed by `npm run discord:register`. Blank disables the bot.
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
