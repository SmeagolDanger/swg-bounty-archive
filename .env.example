DATABASE_URL=postgresql://swg:replace_with_long_random_password@postgres:5432/swg_bounty
POSTGRES_USER=swg
POSTGRES_PASSWORD=replace_with_long_random_password
POSTGRES_DB=swg_bounty
POSTGRES_PORT=54329
SWG_BASE_URL=https://swglegends.com
INGESTION_ENABLED=true
INGESTION_INTERVAL_SECONDS=300
INGESTION_CONCURRENCY=2
INGESTION_TIMEOUT_MS=10000
INGESTION_MAX_RETRIES=3
ADMIN_USERNAME=admin
# Keep the single quotes: Docker Compose otherwise expands bcrypt's $ characters.
ADMIN_PASSWORD_HASH=''
LOG_LEVEL=info
# Optional hosted observability. Both values are required to enable Axiom delivery.
AXIOM_TOKEN=
# Recommended when enabled: outer-rim-ledger-development
AXIOM_DATASET=
AXIOM_ENVIRONMENT=development
HEALTH_WORKER_STALE_SECONDS=900
PUBLIC_API_RATE_LIMIT_PER_MINUTE=120
APP_PORT=3017
# Optional public origin, e.g. https://ledger.example.com. Enables canonical URLs and absolute metadata.
PUBLIC_SITE_URL=
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=0
# Optional Discord slash-command bot (docs/discord-bot.md). Blank disables it.
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
